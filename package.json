{
  "name": "combodex",
  "version": "0.2.0",
  "private": true,
  "description": "Roguelite de deckbuilding basé sur les vraies cartes du JCC Pokémon",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig tsconfig.ui.json --fail-on-warnings",
    "lint": "biome check .",
    "build:data": "node scripts/build-data.ts",
    "build:icons": "node scripts/build-icons.ts",
    "play": "node src/cli/main.ts",
    "sim": "node src/sim/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@lucide/svelte": "^1.70.0"
  }
}
